# Public subpath on the Hub domain (default /tesway). Must match the Hub rewrite.
NEXT_PUBLIC_BASE_PATH=/tesway

# Optional. Leave empty until real IDs exist. No tracking script loads when empty.
# Review consent requirements before filling these in.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
